# --- API CONFIGURATION ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# --- AI PROVIDER (GOOGLE GEMINI) ---
# API Key obtida no Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
# Tempo máximo de espera em segundos para a resposta da IA
AI_TIMEOUT=2.0

# --- DATABASE ---
# URL de conexão para o SQLModel (SQLite ou PostgreSQL)
DATABASE_URL=sqlite:///./dev.db