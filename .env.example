# --- API CONFIGURATION ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# --- AI PROVIDER (GOOGLE GEMINI) ---
GEMINI_API_KEY=SUA_CHAVE_API_AQUI
# Endpoint v1beta é necessário para modelos em Preview e recursos JSON
AI_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta
# Modelo estável e rápido identificado na sua lista de permissões
AI_MODEL_NAME=gemini-3.1-flash-lite-preview
AI_TIMEOUT=2.0

# --- DATABASE ---
# URL de conexão para o SQLModel (SQLite ou PostgreSQL)
DATABASE_URL=sqlite:///./dev.db